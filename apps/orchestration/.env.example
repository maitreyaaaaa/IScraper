# Backend
PORT=3001
STORAGE_MODE=local
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_FILE_SIZE_BYTES=26214400
IMPORT_CHUNK_SIZE_BYTES=4194304
IMPORT_UPLOAD_BUCKET=import-uploads
NOTE_ASSET_BUCKET=note-assets
MAX_NOTE_IMAGE_FILE_SIZE_BYTES=5242880
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
FEEDBACK_RATE_LIMIT_MAX=20
IMPORT_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=180
CHECKOUT_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=30

# Local development only. Production should use Supabase.
DATA_PATH=../../data

# Supabase production mode
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# App-owned AI provider for paid-credit indexing.
# Keep this server-side only. Never expose it in VITE_* frontend env vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_SEARCH_MODEL=gpt-4o
OPENAI_MEDIA_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
INDEXING_CONCURRENCY=3

# AI search and library chat answer layer. Uses the app OpenAI key server-side only.
AI_SEARCH_ENABLED=true
AI_SEARCH_RESULT_LIMIT=8
AI_SEARCH_CONTEXT_LIMIT=5
AI_SEARCH_TIMEOUT_MS=12000
AI_SEARCH_RATE_LIMIT_MAX=60
AI_SEARCH_DAILY_LIMIT=1000
AI_SEARCH_CACHE_TTL_MS=21600000

# Required before storing user BYOK credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Admin/credits foundation. Checkout stays disabled until this is true.
ADMIN_API_KEY=
ADMIN_EMAILS=you@example.com
ADMIN_PASSWORD=
WORKER_API_KEY=
WORKER_BATCH_SIZE=10
WORKER_SCAN_LIMIT=20
WORKER_LEASE_MS=900000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=60000
WORKER_MAX_RETRY_BACKOFF_MS=1800000
WORKER_PER_USER_CONCURRENCY=1
WORKER_GLOBAL_CONCURRENCY=3
WORKER_IDLE_MS=5000
WORKER_CANARY_LIMIT=0
WORKER_RUN_ONCE=false
STORAGE_IMPORT_BATCH_SIZE=1
DEFER_STORAGE_IMPORT_PROCESSING=false
WORKER_RATE_LIMIT_MAX=30
INLINE_INDEXING_ENABLED=false
ENABLE_CREDIT_CHECKOUT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Telegram save bot. Use BotFather for TELEGRAM_BOT_TOKEN and set
# TELEGRAM_WEBHOOK_SECRET as the secret_token when registering the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional observability. PostHog is used for error tracking/events when configured.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true
POSTHOG_DEBUG=false
POSTHOG_FLUSH_IMMEDIATE=false
LOG_LEVEL=info
