# Backend
PORT=3001
STORAGE_MODE=local
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_FILE_SIZE_BYTES=26214400
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
FEEDBACK_RATE_LIMIT_MAX=20
IMPORT_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=180
CHECKOUT_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=30

# Local development only. Production should use Supabase.
DATA_PATH=../../data

# Supabase production mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App-owned AI provider for the included free indexing allowance.
# Keep this server-side only. Never expose it in VITE_* frontend env vars.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_MEDIA_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Required before storing user BYOK credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Admin/credits foundation. Checkout stays disabled until this is true.
ADMIN_API_KEY=
ENABLE_CREDIT_CHECKOUT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
