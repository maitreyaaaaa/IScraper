{
  "manifest_version": 3,
  "name": "Save to IScraper",
  "description": "Save the current tab into your IScraper brain.",
  "version": "0.2.0",
  "action": {
    "default_title": "Save to IScraper",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"]
}
