{
  "manifest_version": 3,
  "name": "Save to IScraper",
  "short_name": "IScraper",
  "description": "Capture the current page URL or a selected screenshot into your private IScraper library.",
  "version": "0.4.0",
  "minimum_chrome_version": "114",
  "homepage_url": "https://iscraper.vercel.app/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to IScraper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://iscraper.vercel.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "externally_connectable": {
    "matches": [
      "https://iscraper.vercel.app/*"
    ]
  },
  "options_page": "options/options.html"
}
